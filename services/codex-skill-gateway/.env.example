GATEWAY_API_KEY=replace-with-gateway-token
ADMIN_API_KEY=replace-with-separate-admin-token
CODEX_API_KEY=
CODEX_MODEL_PROVIDER=proxy
CODEX_MODEL=gpt-5.5
CODEX_PROXY_BASE_URL=https://tokenflux.dev/v1
CODEX_PROXY_ENV_KEY=PROXY_API_KEY
PROXY_API_KEY=replace-with-proxy-token
IMAGE_API_BASE_URL=https://www.vivaapi.cn/v1
IMAGE_API_ENV_KEY=IMAGE_API_KEY
IMAGE_API_KEY=replace-with-image-token
IMAGE_MODEL=gpt-image-1.5
REDIS_URL=redis://codex-redis:6379/0
RUNS_DIR=/workspace/runs
USER_SKILLS_DIR=/workspace/user-skills
SKILLS_DIR=/opt/codex-skills
REGISTRY_PATH=/app/skill_registry.json
CODEX_HOME=/codex-home
SYNC_WAIT_SECONDS=180
TASK_RETENTION_SECONDS=604800
LOG_LEVEL=INFO
