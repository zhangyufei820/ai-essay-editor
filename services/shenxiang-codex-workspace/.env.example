TZ=Asia/Shanghai
HOST_BIND_IP=127.0.0.1
HOST_BIND_PORT=3140

PUBLIC_BASE_URL=https://api.aiphui.top/codex
NEW_API_BASE_URL=https://api.aiphui.top/v1

ADMIN_API_KEY=change-me
REDIS_URL=redis://shenxiang-codex-workspace-redis:6379/0
RUNS_DIR=/workspace/runs
USER_SKILLS_DIR=/workspace/user-skills
SKILLS_DIR=/opt/codex-skills
REGISTRY_PATH=/app/skill_registry.json
CODEX_HOME=/codex-home

DEFAULT_CHAT_MODEL=gpt-5.4-mini
DEFAULT_SMALL_FAST_MODEL=gpt-5.4-mini
DEFAULT_WEB_SEARCH_MODEL=gpt-5.4
DEFAULT_IMAGE_MODEL=gpt-image-2-4K
DEFAULT_VIDEO_MODEL=seedance-2.0
DEFAULT_CODE_MODEL=gpt-5.4-mini
AUTO_TOKEN_NAME=星人 Codex 文本令牌
CLAUDE_TOKEN_NAME=星人 Claude 高阶令牌
IMAGE_TOKEN_NAME=星人图像生成令牌
VIDEO_TOKEN_NAME=星人视频生成令牌
AUTO_TOKEN_CACHE_SECONDS=3600
CODEX_ALLOWED_MODELS=gpt-5.4-mini,gpt-5.4,gpt-5.5
CLAUDE_ALLOWED_MODELS=claude-haiku-4-5-20251001-full,claude-sonnet-4-5-20250929-fast,claude-sonnet-4-6-fast,claude-sonnet-4-6-full,claude-opus-4-8-fast,claude-opus-4-8-full
IMAGE_ALLOWED_MODELS=gpt-image-2-4K,grok-imagine-image
VIDEO_ALLOWED_MODELS=seedance-2.0,grok-video-super-720p

SYNC_WAIT_SECONDS=180
TASK_RETENTION_SECONDS=86400
MAX_FILES_PER_TASK=20
MAX_FILE_BYTES=120000
MAX_IMAGE_BYTES=6000000
MAX_USER_SKILLS=30
FAST_PATH_FIRST_DELTA_TIMEOUT_SECONDS=6
FAST_PATH_MAX_OUTPUT_TOKENS=1200
LOG_LEVEL=INFO
