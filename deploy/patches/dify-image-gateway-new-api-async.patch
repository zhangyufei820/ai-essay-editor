+async def call_async_image_generation(
+    client: httpx.AsyncClient,
+    provider: Dict[str, str],
+    request_payload: Dict[str, Any],
+) -> tuple[int, Dict[str, Any]]:
+    submit_response = await client.post(
+        f"{provider['base_url']}/images/generations?async=true",
+        headers=upstream_headers(provider["api_key"]),
+        json=request_payload,
+        timeout=PRIMARY_UPSTREAM_TIMEOUT,
+    )
+    submit_raw = parse_upstream_json(submit_response)
+    if not 200 <= submit_response.status_code < 300:
+        return submit_response.status_code, submit_raw
+
+    task_id = ""
+    if isinstance(submit_raw, dict):
+        task_id = str(submit_raw.get("task_id") or submit_raw.get("id") or "").strip()
+        if not task_id and isinstance(submit_raw.get("data"), dict):
+            task_id = str(submit_raw["data"].get("task_id") or "").strip()
+    if not task_id:
+        return 502, {"error": {"type": "MissingAsyncTaskId", "message": "missing async image task id"}}
+
+    deadline = time.monotonic() + PRIMARY_UPSTREAM_ASYNC_TIMEOUT
+    poll_url = f"{provider['base_url']}/images/tasks/{task_id}"
+    while time.monotonic() < deadline:
+        await asyncio.sleep(max(0.5, PRIMARY_UPSTREAM_ASYNC_POLL_INTERVAL))
+        poll_response = await client.get(
+            poll_url,
+            headers=upstream_headers(provider["api_key"], include_json_content_type=False),
+            timeout=UPSTREAM_TIMEOUT,
+        )
+        poll_raw = parse_upstream_json(poll_response)
+        if not 200 <= poll_response.status_code < 300:
+            return poll_response.status_code, poll_raw
+
+        status = str(
+            poll_raw.get("status") or poll_raw.get("task_status") or ""
+        ).strip().upper()
+        if status in {"SUCCESS", "SUCCEEDED", "COMPLETED"}:
+            return 200, poll_raw
+        if status in {"FAILURE", "FAILED", "CANCELLED", "CANCELED", "TIMEOUT"}:
+            return 502, poll_raw
+
+    return 504, {"error": {"type": "AsyncImageTimeout", "message": "async image task timeout"}}
