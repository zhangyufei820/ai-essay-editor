+def normalize_async_image_success(
+    raw: Dict[str, Any],
+    provider: Dict[str, str],
+    request_payload: Dict[str, Any],
+) -> Dict[str, Any]:
+    containers = [raw]
+    data = raw.get("data")
+    if isinstance(data, dict):
+        containers.append(data)
+
+    candidates: List[str] = []
+    for container in containers:
+        item = container.get("item")
+        if isinstance(item, dict):
+            candidates.extend([
+                str(item.get("originalUrl") or "").strip(),
+                str(item.get("url") or "").strip(),
+                str(item.get("displayUrl") or "").strip(),
+                str(item.get("cachedUrl") or "").strip(),
+            ])
+        candidates.extend([
+            str(container.get("result_url") or "").strip(),
+            str(container.get("url") or "").strip(),
+        ])
+        nested_data = container.get("data")
+        if isinstance(nested_data, list) and nested_data and isinstance(nested_data[0], dict):
+            candidates.append(str(nested_data[0].get("url") or "").strip())
 
+    image_url = next((candidate for candidate in candidates if candidate), "")
+    if not image_url:
+        return raw
+    if image_url.startswith("/"):
+        image_url = urljoin(f"{provider['base_url']}/", image_url)
 
+    return {
+        "created": raw.get("created") or raw.get("created_at") or int(time.time()),
+        "data": [{"url": image_url}],
+        "model": request_payload.get("model", ""),
+        "usage": raw.get("usage", {}),
+    }
+
