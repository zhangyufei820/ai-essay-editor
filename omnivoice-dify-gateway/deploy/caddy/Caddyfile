voice-api.shenxiang.school {
  encode gzip zstd
  request_body {
    max_size 50MB
  }
  reverse_proxy gateway:8000 {
    transport http {
      read_timeout 600s
      write_timeout 600s
      dial_timeout 30s
    }
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }
}

