[Unit]
Description=OmniVoice Dify Gateway Docker Compose stack
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/data/ai-essay-editor/omnivoice-dify-gateway
EnvironmentFile=/data/ai-essay-editor/omnivoice-dify-gateway/.env
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml up -d --build
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

